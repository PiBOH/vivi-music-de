  AddLanguage('ukrainian', 'Українська', 'Мова');
  AddLanguage('hebrew', 'עִבְרִית', 'שפה');
  AddLanguage('arabic', 'العربية', 'اللغة');
  AddLanguage('persian', 'فارسی', 'زبان برنامه');
  AddLanguage('hindi', 'हिन्दी', 'भाषा');
  AddLanguage('assamese', 'অসমীয়া', 'ভাষা');
  AddLanguage('bengali', 'বাংলা', 'ভাষা');
